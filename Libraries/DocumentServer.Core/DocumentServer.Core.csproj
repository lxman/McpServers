<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- NPOI 2.8.0 requires explicit acceptance of the OSMF EULA at build time. -->
        <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
    </PropertyGroup>

    <ItemGroup>
        <!-- Office Processing -->
        <PackageReference Include="ClosedXML"  />
        <PackageReference Include="DocumentFormat.OpenXml"  />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"  />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"  />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"  />
        <PackageReference Include="Microsoft.Extensions.Logging"  />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"  />
        <PackageReference Include="ShapeCrawler"  />
        <!-- Pinned forward: NPOI 2.8.0 pulls System.Security.Cryptography.Xml 8.0.2, which carries known
             high-severity advisories. Direct reference takes the central version here and in DocumentMcp. -->
        <PackageReference Include="System.Security.Cryptography.Xml"  />
        <PackageReference Include="NPOI"  />

        <!-- PDF Processing -->
        <PackageReference Include="PdfPig"  />

        <!-- Search & Analysis -->
        <PackageReference Include="Lucene.Net"  />
        <PackageReference Include="Lucene.Net.Analysis.Common"  />
        <PackageReference Include="Lucene.Net.QueryParser"  />
        <PackageReference Include="FuzzySharp"  />

        <!-- OCR -->
        <PackageReference Include="TesseractOCR"  />
        <PackageReference Include="SixLabors.ImageSharp"  />

        <!-- API -->
        <PackageReference Include="Microsoft.Extensions.Caching.Memory"  />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Mcp.Common.Core\Mcp.Common.Core.csproj" />
      <ProjectReference Include="..\MsOfficeCrypto\MsOfficeCrypto.csproj" />
    </ItemGroup>

</Project>
