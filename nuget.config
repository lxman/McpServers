<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds a local folder feed for PdfLibrary builds made from the first-party source at
  ../PdfLibrary rather than the published 2.6.2 package.

  2.6.3-local carries two fixes for scanned pages that rasterise to blank white with no
  error: unresolved indirect /Height on image XObjects, and Group 3 CCITT lines separated
  by fill bits the decoder could not skip. Both affect the OCR fill directly.

  Regenerate with:
    dotnet pack PdfLibrary/PdfLibrary.csproj -c Release -p:Version=2.6.3-local \
        -o C:\Users\Michael.Jordan\sources\local-nuget
-->
<configuration>
  <packageSources>
    <add key="local" value="C:\Users\Michael.Jordan\sources\local-nuget" />
  </packageSources>
</configuration>
