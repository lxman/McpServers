{
  "code-assist": {
    "project": "CodeAssistMcp/CodeAssistMcp.csproj",
    "assembly": "CodeAssistMcp.dll",
    "deployRoot": "deploy/code-assist",
    "pool": "shared",
    "overlapAllowed": false,
    "eagerStart": true,
    "idleTimeoutMinutes": 0,
    "startupTimeoutSeconds": 120
  },
  "time-utility": {
    "project": "McpUtilitiesServer/McpUtilitiesServer.csproj",
    "assembly": "McpUtilitiesServer.dll",
    "deployRoot": "deploy/time-utility",
    "pool": "per-session",
    "overlapAllowed": true,
    "eagerStart": false,
    "idleTimeoutMinutes": 30,
    "startupTimeoutSeconds": 30
  }
}
