  {
    "name": "check_exit_code",
    "description": "Execute a command and return just the exit code. Useful for simple checks.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "connectionName": {
          "description": "Name of the SSH connection",
          "type": "string"
        },
        "command": {
          "description": "Command to execute",
          "type": "string"
        }
      },
      "required": [
        "connectionName",
        "command"
      ]
    }
  },
  {
    "name": "connect",
    "description": "Connect to an SSH server. Returns connection info on success.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "connectionName": {
          "description": "Unique name for this connection",
          "type": "string"
        },
        "host": {
          "description": "Hostname or IP address",
          "type": "string"
        },
        "username": {
          "description": "SSH username",
          "type": "string"
        },
        "privateKeyPath": {
          "description": "Path to private key file (optional if password provided)",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "passphrase": {
          "description": "Passphrase for private key (optional)",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "password": {
          "description": "Password (optional if key provided)",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "port": {
          "description": "SSH port (default: 22)",
          "type": "integer",
          "default": 22
        },
        "timeoutSeconds": {
          "description": "Connection timeout in seconds (default: 30)",
          "type": "integer",
          "default": 30
        }
      },
      "required": [
        "connectionName",
        "host",
        "username"
      ]
    }
  },
